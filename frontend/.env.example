# Vite frontend deployment/local overrides.
# Copy to `frontend/.env` for local frontend-only overrides.

# Deployed API origin only, without `/api`.
# Leave empty for same-origin `/api` or the Vite dev proxy.
# Example: VITE_API_BASE_URL=https://longevity-lab-api.onrender.com
VITE_API_BASE_URL=

# Local dev proxy target for `/api` when the backend is not on localhost:8000.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
