# Copy to `.env` for local overrides. `.env` is gitignored.

# App identity / environment
LONGEVITY_LAB_APP_NAME="Longevity Lab API"
LONGEVITY_LAB_ENVIRONMENT=development

# API routing
# Note: the frontend dev proxy and client assume `/api`. If you change this, update `frontend/vite.config.ts`
# and any frontend API base paths accordingly.
LONGEVITY_LAB_API_PREFIX=/api

# CORS (comma-separated origins). Keep this scoped to local dev.
# Note: '*' is rejected (we default `allow_credentials=True`).
# Set empty to disable CORS middleware entirely (safe when using the Vite `/api` dev proxy).
# Keep both `localhost` and `127.0.0.1` if you use the bundled Playwright config, which defaults to
# `http://127.0.0.1:5173`.
# Example: LONGEVITY_LAB_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173
LONGEVITY_LAB_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deployment frontend API origin. For local frontend-only overrides, copy `frontend/.env.example`
# to `frontend/.env`; Vercel/Render read this from their project environment settings at build time.
# Leave empty for same-origin `/api` or local dev proxy.
# For Vercel/Render static frontend + Render API, set this to the API origin only, without `/api`.
# Example: VITE_API_BASE_URL=https://longevity-lab-api.onrender.com
VITE_API_BASE_URL=

# Optional local Vite proxy target when the backend is not on localhost:8000.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Local filesystem layout
LONGEVITY_LAB_DATA_DIR=data
LONGEVITY_LAB_ARTIFACTS_DIR=artifacts

# Backend engine selection:
# - auto: use a valid local artifact bundle when present, otherwise fall back to demo scoring (default)
# - demo: deterministic placeholder scoring
# - artifact: require trained artifacts from `artifacts/models/` (requires a local bundle + manifest;
#   create one with `pdm install -G dev -G train` then `pdm run python -m longevity_lab.pipeline.train`)
LONGEVITY_LAB_ENGINE=auto

# Optional: pick a specific artifact bundle id under `artifacts/models/<bundle_id>/`.
# LONGEVITY_LAB_ARTIFACT_BUNDLE=real-20260508-xgboost-shap

# Optional deployment artifact download. Set these in Render when using artifact mode.
# LONGEVITY_LAB_ARTIFACT_URL=https://github.com/Adredes-weslee/longevity-lab/releases/download/model-real-20260508-xgboost-shap/real-20260508-xgboost-shap.zip
# LONGEVITY_LAB_ARTIFACT_SHA256=1c71eca4aff814f2c15d540ecb6a995230a4ac956232fd2d2b53e4eb4d3ab0aa

# Optional deployment evidence bundle download for Community Context. These assets populate
# context/research panels only; they are not used by Explorer scoring.
# LONGEVITY_LAB_EVIDENCE_BUNDLE=public-evidence-20260508-community-context
# LONGEVITY_LAB_EVIDENCE_BUNDLE_URL=https://github.com/Adredes-weslee/longevity-lab/releases/download/evidence-public-20260508-community-context/public-evidence-20260508-community-context.zip
# LONGEVITY_LAB_EVIDENCE_BUNDLE_SHA256=be50ac0392078eca507d42f3ed8a8f37132eadb4df8fc3dc00c480bee737dc40

# Security note: `artifact` mode loads local `joblib` artifacts. Treat bundles as trusted outputs
# only (do not point this to files from untrusted sources).
